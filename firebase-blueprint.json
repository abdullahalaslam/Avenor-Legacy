          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "title",
        "category",
        "amount",
        "expenseDate",
        "note",
        "createdById",
        "createdByName",
        "createdAt"
      ]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app notification targeted to Admin or a specific Staff user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientRole": {
          "type": "string",
          "enum": ["admin", "staff", "user"],
          "maxLength": 16
        },
        "recipientUserId": {
          "type": "string",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "referenceId": {
          "type": "string",
          "maxLength": 128
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "recipientRole",
        "type",
        "title",
        "message",
        "isRead",
        "createdAt"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable operational activity audit log.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "actorRole": {
          "type": "string",
          "enum": ["admin", "staff"],
          "maxLength": 16
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "details": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["id", "actorId", "actorName", "actorRole", "action", "details", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted Main Admin UID records."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Staff and Admin profile records with RBAC approval status."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Product catalog entries (without secret unit cost)."
    },
    "/product_costs/{productId}": {
      "schema": { "$ref": "#/entities/ProductCost" },
      "description": "Admin-only unit costs per product."
    },
    "/stock_variants/{variantId}": {
      "schema": { "$ref": "#/entities/StockVariant" },
      "description": "Per (productId, size, colour) inventory state."
    },
    "/stock_movements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Append-only stock movement audit ledger."
    },
    "/stock_idempotency/{requestId}": {
      "schema": { "$ref": "#/entities/StockIdempotency" },
      "description": "Idempotency locks for duplicate stock submission prevention."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders and reservation workflow."
    },
    "/ready_texts/{templateId}": {
      "schema": { "$ref": "#/entities/ReadyTextTemplate" },
      "description": "Customer message templates."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Admin-only operational expenses."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Role-targeted and user-targeted notifications."
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Append-only system activity audit logs."
    }
  }
}
