          "minLength": 1,
          "maxLength": 2000
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      },
      "required": ["id", "title", "category", "body", "isActive", "createdAt", "updatedAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operational expense ledger entry managed by Admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": "number"
        },
        "expenseDate": {
          "type": "string",
          "maxLength": 32
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
